#include <iostream>
#include <vector>
#include <utility> 
using namespace std;

int main()
{
    int size;
    vector<pair<int, int>> scope;
    cin >> size;
    vector<int> arrayIn(size, 0);
    vector<int> prevsum(size, 0);
    int presum = 0;
    for (int i = 0; i < size; i++)
    {
        prevsum[i] = presum;
        cin >> arrayIn[i];
        presum += arrayIn[i];

    }
    int upper, lower;
    while (cin >> lower >> upper)
    {
        cout << prevsum[upper] - prevsum[lower] + arrayIn[upper] << endl;
    }
}
