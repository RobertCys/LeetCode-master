class Solution {
public:
    int removeElement(vector<int>& nums, int val) {//始终保持要移除的元素在不移除的元素后面
        if(nums.size() == 0)
            return 0;
        int result = 0;
        for(int i = 0; i < nums.size(); i++){
            if(nums[i] != val)
                result++;
        }
        for(int i = 0; i < nums.size() - 1; i++){
            if(nums[i] == val){
                for(int j = i + 1; j < nums.size(); j++){
                    if(nums[j] != val){
                        nums[i] = nums[j];
                        nums[j] = val;
                        break;
                    }
                }
            }
        }
        return result;
    }
};
