class Solution {
public:
    vector<int> sortedSquares(vector<int>& nums) {
        vector<int> result(nums.size());
        int i = 0, j = nums.size() - 1, k = nums.size() - 1;
        while(j >= i && k >= 0){
            if(abs(nums[j]) >= abs(nums[i])){
                result[k--] = pow(nums[j--], 2);
            }
            else if(abs(nums[j]) < abs(nums[i])){
                result[k--] = pow(nums[i++], 2);
            }
        }
        return result;
    }
};
